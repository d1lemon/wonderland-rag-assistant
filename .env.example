# Required for Groq generation
GROQ_API_KEY=replace_with_your_groq_api_key

# GitHub account that owns the public processed corpus files
GITHUB_USERNAME=replace_with_your_github_username

# Groq model selected from the models available to your Groq account
GROQ_MODEL=groq/compound-mini

# Comma-separated origins permitted to call the API.
# Add your GitHub Pages address before public deployment.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# Environment label for logging and deployment
ENVIRONMENT=development
